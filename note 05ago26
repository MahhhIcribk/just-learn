//quando o usuaro digita "" ou "null" vai sair 0 e quando a letra vai sair um NaN

const verificaNaoVazio = (valor:string|null):boolean => (valor!=="")? true:false; // vai verifica se o valor e valido

const verificaNaoNull = (valor:string|null):boolean => (valor!==null)? true:false;

const verificaSeNumero = (valor:string|null):boolean => (!isNaN(Number(valor)))? true:false; // vai verifica se o valor e valido

//is not a number funcao que verifica se o valor nao e not a number nesse caso se o valor se for um numero vai ser falso e ao contro se nao for mas no caso eu quro ao contrari desse resultaso

//let numeros : number[]|null[] = []

const validaValoresNumericos = (valor:string|null):number => {
do {
    valor = prompt("Informe o valor: ");
    if(!(verificaNaoVazio(valor) && verificaNaoNull(valor) && verificaSeNumero(valor)));{
        alert("Informe somente valores numericos")
    }
} while (!(verificaNaoVazio(valor) && verificaNaoNull(valor) && verificaSeNumero(valor)));

return Number(valor)

}

let numero1:number, numero2:number;

